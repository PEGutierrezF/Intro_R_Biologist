setwd("C:/Users/pablo.gutierrez1/OneDrive/Curriculum/07_ Cursos/Intro_R_Biologist/classes/Module 8 Descriptive Statistics")
fish <- read.csv("fish.csv")
fish <- read.csv("fish_data.csv")
head(fish)
install.packages("lessR")
library(lessR)
pivot(fish, c(IQR, skew, kurtosis,max,
min, mean, sd, var), Length)
hist(fish$Length)
q25 <- quantile(fish$Length,prob=(0.25))
q75 <- quantile(fish$Length,prob=(0.75))
iqr <- q75 - q25
lower <- q25 - (1.5*iqr)
lower
upper <- q75 - (1.5+iqr)
upper
