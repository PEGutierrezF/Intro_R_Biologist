boxplot(fish$Length)
install.packages("BSDA")
library(BSDA)
library(BSDA)
sample_mean <- c(15.84, 15.33, 15.58)
z.test(sample_mean,
alternative = "greater",
mu= 15,
sigma.x =0.25)
s_mean <- mean(15.84, 15.33, 15.58)
z.test(s_mean ,
alternative = "greater",
mu= 15,
sigma.x =0.25)
s_mean - 15/(0.25/sqrt(3))
(s_mean - 15)/(0.25/sqrt(3))
sample_mean <- c(15.84, 15.33, 15.58)
(s_mean - 15)/(0.25/sqrt(3))
z.test(sample_mean,
alternative = "greater",
mu= 15,
sigma.x =0.25)
